  <script>
    document.querySelectorAll('[data-pillar]').forEach(function(card) {
      card.addEventListener('click', function(e) {
        if (e.target.closest('a') && !e.target.closest('.pillar-expand')) return;
        var isActive = card.classList.contains('active');
        document.querySelectorAll('[data-pillar]').forEach(function(c) {
          c.classList.remove('active');
        });
        if (!isActive) {
          card.classList.add('active');
        }
      });
    });

    var tabs = document.querySelectorAll('.tab');
    var panels = {
      soc: document.getElementById('panel-soc'),
      eng: document.getElementById('panel-eng'),
      support: document.getElementById('panel-support'),
      sales: document.getElementById('panel-sales'),
      onboarding: document.getElementById('panel-onboarding')
    };

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var target = tab.getAttribute('data-tab-target');

        tabs.forEach(function(t) { t.classList.remove('active'); });
        tab.classList.add('active');

        Object.keys(panels).forEach(function(key) {
          if (key === target) {
            panels[key].classList.add('active');
          } else {
            panels[key].classList.remove('active');
          }
        });
      });
    });

    function animateCountUp(el, target, duration) {
      var start = 0;
      var startTime = null;
      var isCurrency = el.textContent.trim().startsWith('$');
      var isPercent = el.textContent.trim().endsWith('%');

      function format(value) {
        var rounded = Math.round(value);
        if (isCurrency) {
          return '$' + rounded.toLocaleString();
        }
        if (isPercent) {
          return rounded.toLocaleString() + '%';
        }
        return rounded.toLocaleString();
      }

      function step(timestamp) {
        if (!startTime) startTime = timestamp;
        var progress = Math.min((timestamp - startTime) / duration, 1);
        var current = start + (target - start) * progress;
        el.textContent = format(current);
        if (progress < 1) {
          window.requestAnimationFrame(step);
        }
      }

      window.requestAnimationFrame(step);
    }

    window.addEventListener('load', function() {
      var statEls = document.querySelectorAll('[data-countup]');
      statEls.forEach(function(el) {
        var raw = el.getAttribute('data-countup');
        var value = parseInt(raw, 10);
        if (!isNaN(value)) {
          animateCountUp(el, value, 1100);
        }
      });
    });
  </script>
